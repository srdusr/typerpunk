# Cargo.lock is committed on purpose: this workspace produces binaries, not
# a library, so the lockfile is what makes a deployed build reproducible and
# a dependency audit meaningful.

/target
/archives
/web/wasm
/typerpunk.db
/typerpunk.db-journal
/crates/server/*.db
/crates/server/*.db-journal
/crates/server/.env

# Browser console dump kept for debugging, not part of the project
/console-export-*.txt

# Python bytecode from the Playwright test suite
__pycache__/
*.pyc
